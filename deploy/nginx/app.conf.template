# The application host. /api/v1 goes to Core's user listener; everything else is the static app with
# a fallback to index.html for client-side routes. Nothing here routes to Core's bot or ops listeners
# (SEC-OPS-4). The share page route never belongs on this host.
server {
    listen 8080;
    server_name ${APP_HOST};
    server_tokens off;
    client_max_body_size 30m;   # the attachment limit plus headroom; Core enforces its own limit

    root /usr/share/nginx/html;

    location /api/v1/ {
        proxy_pass http://${CORE_USER_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $http_x_forwarded_proto;
        proxy_set_header Connection "";
        proxy_buffering off;          # server-sent events and streamed downloads
        proxy_read_timeout 1h;
        proxy_request_buffering off;  # uploads stream through
        # Core sets the response headers of its own answers; nginx adds none, so nothing is sent twice.
    }
    location /api/ { return 404; }

    # Hashed assets never change; the shell and the worker must be revalidated.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/headers.conf;
        try_files $uri =404;
    }
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/headers.conf;
        try_files $uri =404;
    }
    location / {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/headers.conf;
        try_files $uri /index.html;
    }
}
