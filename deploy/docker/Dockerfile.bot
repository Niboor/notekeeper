# Matrix bot: needs cgo and libolm for end-to-end encryption, so the runtime image is Debian slim with
# libolm and nothing else, running as a non-root user (SEC-OPS-2). Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.bot -t notekeeper/matrix-bot .
FROM golang:1.27-bookworm AS build
ARG VERSION=dev
RUN apt-get update && apt-get install -y --no-install-recommends libolm-dev && rm -rf /var/lib/apt/lists/*
WORKDIR /src
# The dependencies come first, in a layer of their own: it changes only with a go.mod or go.sum, so a change
# to the sources reuses it (from the layer cache in CI).
COPY go.work go.work.sum ./
COPY core/go.mod core/go.sum ./core/
COPY bots/sdk/go.mod bots/sdk/go.sum ./bots/sdk/
COPY bots/matrix/go.mod bots/matrix/go.sum ./bots/matrix/
RUN cd bots/matrix && go mod download
COPY bots ./bots
RUN cd bots/matrix && CGO_ENABLED=1 GOFLAGS=-trimpath go build -ldflags "-s -w -X main.Version=${VERSION}" -o /out/matrix-bot ./cmd/matrix-bot

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends libolm3 ca-certificates && rm -rf /var/lib/apt/lists/* \
 && useradd --system --uid 65532 --no-create-home --shell /usr/sbin/nologin nonroot
COPY --from=build /out/matrix-bot /matrix-bot
USER 65532:65532
EXPOSE 9091
ENTRYPOINT ["/matrix-bot"]
CMD ["run"]
