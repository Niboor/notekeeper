# Web: the built single-page app served by unprivileged nginx with the security headers of
# docs/design/07 section 7 (SEC-API-8, SEC-SHR-5). One image serves the application host and the
# share host through two server blocks. Build from the repository root:
#   docker build -f deploy/docker/Dockerfile.web -t notekeeper/web .
FROM node:26-bookworm-slim AS build
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY api /src/api
COPY web ./
RUN npm run build

FROM nginxinc/nginx-unprivileged:1.31-alpine
COPY --from=build /src/web/dist /usr/share/nginx/html
# The official image renders /etc/nginx/templates/*.template with the environment at start (envsubst).
COPY deploy/nginx/app.conf.template deploy/nginx/share.conf.template /etc/nginx/templates/
COPY deploy/nginx/headers.conf /etc/nginx/snippets/headers.conf
ENV APP_HOST=localhost SHARE_HOST=share.localhost CORE_USER_UPSTREAM=core:8080 CORE_PUBLIC_UPSTREAM=core:8082
USER 101
EXPOSE 8080
